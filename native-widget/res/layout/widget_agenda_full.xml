<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_agenda_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="AGENDA RJP"
            android:textColor="#6EE0C9" android:textStyle="bold" android:textSize="14sp"/>
        <TextView android:id="@+id/widget_add" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="+"
            android:contentDescription="Criar compromisso" android:padding="8dp"
            android:textStyle="bold" android:textSize="19sp" android:textColor="#6EE0C9"/>
        <TextView android:id="@+id/widget_voice" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="VOZ"
            android:contentDescription="Ditar compromisso" android:padding="6dp"
            android:textStyle="bold" android:textSize="11sp" android:textColor="#6EE0C9"/>
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="ABRIR  ›"
            android:padding="4dp" android:textColor="#9ED5CC" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_subtitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:layout_marginBottom="7dp"
        android:text="Hoje" android:textColor="#C9DBE4" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_row_1" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_row_2" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_row_3" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_row_4" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_ip_alerts"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="AVISOS IP  ›" android:contentDescription="Abrir notificações profissionais"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        android:gravity="center" android:textStyle="bold"
        android:textColor="#FFD187" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_updated"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="Sincronizado ao abrir a app"
        android:textColor="#9EBDC4" android:textSize="9sp" android:singleLine="true"
        android:ellipsize="end"/>
</LinearLayout>
