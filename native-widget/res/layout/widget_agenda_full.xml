<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_agenda_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="PLANEAMENTO RJP" android:textColor="#6EE0C9" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/widget_add" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+" android:contentDescription="Criar compromisso" android:padding="6dp"
            android:textStyle="bold" android:textSize="18sp" android:textColor="#6EE0C9"/>
        <TextView android:id="@+id/widget_voice" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="VOZ" android:contentDescription="Ditar compromisso" android:padding="5dp"
            android:textStyle="bold" android:textSize="10sp" android:textColor="#6EE0C9"/>
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ABRIR ›" android:padding="4dp" android:textColor="#9ED5CC" android:textSize="10sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:layout_marginBottom="5dp"
        android:text="SEMANA 46 · 09–15 nov" android:textColor="#C9DBE4" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_day_1" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_day_2" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_day_3" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_day_4" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_day_5" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_day_6" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_day_7" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_ip_alerts" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="AVISOS IP ›" android:contentDescription="Abrir notificações profissionais" android:paddingTop="6dp"
        android:gravity="center" android:textStyle="bold" android:textColor="#FFD187" android:textSize="11sp"/>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="Dados guardados ao abrir a app"
        android:textColor="#9EBDC4" android:textSize="9sp" android:singleLine="true" android:ellipsize="end"/>
</LinearLayout>
