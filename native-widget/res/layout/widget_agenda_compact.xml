<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_agenda_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="AGENDA · 3 DIAS" android:textColor="#6EE0C9" android:textStyle="bold" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:layout_marginBottom="4dp"
        android:text="SEMANA 46" android:textColor="#CCDCE6" android:textSize="10sp" android:maxLines="1"/>
    <TextView android:id="@+id/widget_day_1" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_day_2" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_day_3" style="@style/AgendaWidgetRow"/>
    <TextView android:id="@+id/widget_ip_alerts" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="AVISOS IP ›" android:contentDescription="Abrir notificações profissionais"
        android:gravity="center" android:paddingTop="4dp" android:textStyle="bold" android:textColor="#FFD187" android:textSize="10sp"/>
</LinearLayout>
