<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_agenda_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Terça, 17/11" android:textColor="#181B22" android:textSize="15sp" android:singleLine="true" android:ellipsize="end" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_add" android:layout_width="42dp" android:layout_height="34dp" android:gravity="center" android:text="+" android:textSize="23sp" android:textColor="#FFFFFF" android:background="@drawable/widget_add_button" android:contentDescription="Adicionar atividade"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Próximas atividades" android:textSize="10sp" android:textColor="#61718C" android:layout_marginBottom="8dp"/>
 <TextView android:id="@+id/widget_day_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:padding="8dp" android:layout_marginBottom="8dp" android:background="@drawable/widget_event_card" android:textColor="#17243A" android:textSize="11sp" android:maxLines="3" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_day_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:padding="8dp" android:layout_marginBottom="8dp" android:background="@drawable/widget_event_card" android:textColor="#17243A" android:textSize="11sp" android:maxLines="3" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_day_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:padding="8dp" android:layout_marginBottom="8dp" android:background="@drawable/widget_event_card" android:textColor="#17243A" android:textSize="11sp" android:maxLines="3" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_ip_alerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="AVISOS IP ›" android:textColor="#B36D14" android:textStyle="bold" android:textSize="10sp"/>
</LinearLayout>
