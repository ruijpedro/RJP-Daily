{
  "appId": "pt.rjp.daily",
  "appName": "Agenda RJP",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_rjp",
      "iconColor": "#0E8574"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": false,
        "facebook": false
